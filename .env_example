# Senha usada pelo PostgreSQL do n8n.
# Substitua por uma senha forte e não reutilize este valor em produção.
N8N_DB_PASSWORD=defina_uma_senha_forte

# Credenciais do projeto Supabase.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key

# Chave da API do provedor de LLM usado na ingestão e no agente.
OPENAI_API_KEY=sua_openai_api_key
